{
  "name": "lesca-node-bunnycdn",
  "private": false,
  "description": "use bunny CDN api by node",
  "version": "0.0.24",
  "type": "module",
  "keywords": [
    "bunnycdn",
    "lesca"
  ],
  "files": [
    "lib"
  ],
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js"
    }
  },
  "scripts": {
    "dev": "concurrently \"npx tsx src/api.ts\" \"NODE_ENV=DEV vite --host\"",
    "build": "NODE_ENV=production tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "rm": "rm -rf node_modules/ dist/ package-lock.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.10",
    "eslint": "^10.14.0",
    "express": "^5.3.0",
    "globals": "^17.14.0",
    "multer": "^2.5.0",
    "path": "^0.12.7",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-css-injected-by-js": "^5.0.3",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
